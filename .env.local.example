# Local development database — native PostgreSQL (no Docker).
# Created by scripts/setup-db.ps1; see docs/local-development.md.
# Copy this into your project as .env.local (keep .env.local gitignored).
DATABASE_URL=postgresql://app:localdev@localhost:5432/app_dev

# Split-variable form, if your stack prefers it:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=app
# PGPASSWORD=localdev
# PGDATABASE=app_dev
