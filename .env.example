# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Microsoft Entra ID app registration (Azure portal > App registrations).
# Redirect URI: <origin>/api/auth/callback/microsoft-entra-id
# The issuer pins sign-in to our tenant — only Caizen Homes accounts work.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# --- Claude assistance (optional) ---
# Powers the quiet editor actions (Tighten this, What's missing?, Suggest
# title and summary, Find related). Leave empty and the editor simply works
# without them — the actions never render.
ANTHROPIC_API_KEY=

# --- Admins (optional) ---
# Comma-separated emails allowed to delete any entry (owners can always
# delete their own). The whole permission model lives in src/lib/access.ts.
ADMIN_EMAILS=manpreet@caizenhomes.com

# --- Database ---
# Local dev: native PostgreSQL install (no Docker). One-time setup:
#   psql -U postgres -c "CREATE ROLE kb LOGIN PASSWORD 'kb' CREATEDB;"
#   psql -U postgres -c "CREATE DATABASE kb OWNER kb;"
# CREATEDB lets `prisma migrate dev` create its shadow database.
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb
DIRECT_URL=postgresql://kb:kb@localhost:5432/kb

# Production (Netlify Database / Neon): DATABASE_URL is the pooled connection
# string, DIRECT_URL the direct one. The app's runtime pool uses DATABASE_URL
# (src/lib/db.ts); the Prisma CLI migrates over DIRECT_URL (prisma.config.ts).
# DATABASE_URL=postgresql://...-pooler.../kb?sslmode=require
# DIRECT_URL=postgresql://.../kb?sslmode=require
