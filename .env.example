# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Microsoft Entra ID app registration (Azure portal > App registrations).
# Redirect URI: <origin>/api/auth/callback/microsoft-entra-id
# The issuer pins sign-in to our tenant — only Caizen Homes accounts work.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# --- Database ---
# Local dev: docker compose up -d (Postgres 16 on localhost:5432)
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb
DIRECT_URL=postgresql://kb:kb@localhost:5432/kb

# Production (Netlify Database / Neon): DATABASE_URL is the pooled connection
# string, DIRECT_URL the direct one — Prisma migrations need the direct URL.
# DATABASE_URL=postgresql://...-pooler.../kb?sslmode=require
# DIRECT_URL=postgresql://.../kb?sslmode=require
